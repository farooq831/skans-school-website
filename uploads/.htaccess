# Uploaded files are images and documents only. Nothing in this folder may run as a program.
<FilesMatch "\.(?i:php[0-9]?|phtml|phar|pht|pl|py|cgi|sh|shtml|asp|aspx|jsp)$">
    Require all denied
</FilesMatch>
RemoveHandler .php .phtml .php5 .php7 .php8 .phar
RemoveType .php .phtml .php5 .php7 .php8 .phar
