# SKANS AECHS Campus : site-wide server rules (added Oct 2026)

# Never show a list of files when a folder has no index page.
Options -Indexes

# Block logs, notes, database dumps and Composer files.
<FilesMatch "(^error_log$|\.(md|sql|log|bak|ini)$|^composer\.(json|lock)$)">
    Require all denied
</FilesMatch>

# Files moved on 7 Oct 2026 (folder clean-up): old addresses still work.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} ^(.*/)icons/hr\.pdf$
    RewriteRule ^icons/hr\.pdf$ %1assets/docs/skans-harassment-policy.pdf [R=301,L]
    RewriteCond %{REQUEST_URI} ^(.*/)video/vid\.mp4$
    RewriteRule ^video/vid\.mp4$ %1assets/video/hero.mp4 [R=301,L]
</IfModule>
